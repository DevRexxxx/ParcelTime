generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SocietyStatus {
  SETUP
  ACTIVE
  INACTIVE
}

enum UserRole {
  PLATFORM_ADMIN
  SOCIETY_ADMIN
  RECEPTION
  DELIVERY_EXECUTIVE
  RESIDENT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum UnitMembershipType {
  OWNER
  TENANT
  FAMILY
}

enum UnitMembershipStatus {
  PENDING
  ACTIVE
  ENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParcelStatus {
  RECEIVED
  SCHEDULED
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  UNCLAIMED
  RETURNED_TO_COURIER
}

enum TaskStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  FAILED
  CANCELLED
}

enum DeliveryScheduleStatus {
  ACTIVE
  CANCELLED
  COMPLETED
  SUPERSEDED
}

enum SlotInstanceStatus {
  OPEN
  BLOCKED
}

enum OtpChallengeStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  LOCKED
  REPLACED
}

enum DeliveryAttemptOutcome {
  DELIVERED
  FAILED
}

enum VerificationMethod {
  OTP
  STAFF_OVERRIDE
  IDENTITY_CHECK
}

enum FailureReason {
  NOT_AT_HOME
  REFUSED
  WRONG_ADDRESS
  OTP_NOT_AVAILABLE
  OTHER
}

enum PickupRequestStatus {
  REQUESTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED
}

enum NotificationCategory {
  PARCEL_RECEIVED
  SCHEDULE_CONFIRMED
  SCHEDULE_CHANGED
  REMINDER
  TASK_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  PICKUP_READY
  UNCLAIMED_WARNING
  JOIN_DECISION
  OVERRIDE_FLAGGED
}

enum AssignmentMode {
  ADMIN
  POOL
}

model Society {
  id                     String         @id @default(uuid())
  name                   String
  address                String
  timezone               String         @default("Asia/Kolkata")
  status                 SocietyStatus  @default(SETUP)
  slotCutoffHours        Int            @default(2)
  schedulingHorizonDays  Int            @default(14)
  unclaimedThresholdDays Int            @default(7)
  photoRequired          Boolean        @default(false)
  otpExpiryMinutes       Int            @default(10)
  maxFailedAttempts      Int            @default(3)
  assignmentMode         AssignmentMode @default(POOL)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  members          SocietyMember[]
  towers           Tower[]
  units            Unit[]
  invites          Invite[]
  joinRequests     JoinRequest[]
  storageLocations StorageLocation[]
  parcels          Parcel[]
  slotTemplates    SlotTemplate[]
  slotInstances    SlotInstance[]
  notifications    Notification[]
  outboxEvents     OutboxEvent[]
  auditLogs        AuditLog[]
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  status       String    @default("ACTIVE")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships         SocietyMember[]
  unitMemberships     UnitMembership[]
  receivedParcels     Parcel[]          @relation("ReceivedBy")
  assignedTasks       DeliveryTask[]    @relation("AssignedExecutive")
  deviceTokens        DeviceToken[]
  notifPreferences    NotificationPreference[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  pickupVerifications PickupRequest[]   @relation("VerifiedBy")
  approvedMemberships UnitMembership[]  @relation("ApprovedBy")
}

model SocietyMember {
  id        String       @id @default(uuid())
  societyId String
  userId    String
  roles     UserRole[]
  status    MemberStatus @default(INVITED)
  createdAt DateTime     @default(now())

  society Society @relation(fields: [societyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, societyId])
}

model Tower {
  id        String @id @default(uuid())
  societyId String
  name      String

  society Society @relation(fields: [societyId], references: [id])
  units   Unit[]

  @@unique([societyId, name])
}

model Unit {
  id         String @id @default(uuid())
  societyId  String
  towerId    String
  floor      Int
  unitNumber String
  status     String @default("ACTIVE")

  society Society          @relation(fields: [societyId], references: [id])
  tower   Tower            @relation(fields: [towerId], references: [id])
  members UnitMembership[]
  parcels Parcel[]

  @@unique([societyId, towerId, unitNumber])
}

model UnitMembership {
  id           String               @id @default(uuid())
  unitId       String
  userId       String
  type         UnitMembershipType
  status       UnitMembershipStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime             @default(now())

  unit       Unit  @relation(fields: [unitId], references: [id])
  user       User  @relation(fields: [userId], references: [id])
  approvedBy User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@unique([unitId, userId])
}

model Invite {
  id          String       @id @default(uuid())
  societyId   String
  targetEmail String?
  targetPhone String?
  roles       UserRole[]
  unitId      String?
  tokenHash   String       @unique
  expiresAt   DateTime
  status      InviteStatus @default(PENDING)
  createdById String
  createdAt   DateTime     @default(now())

  society Society @relation(fields: [societyId], references: [id])
}

model JoinRequest {
  id           String             @id @default(uuid())
  societyId    String
  userId       String
  unitId       String
  relationship UnitMembershipType
  status       JoinRequestStatus  @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  society Society @relation(fields: [societyId], references: [id])
}

model StorageLocation {
  id        String  @id @default(uuid())
  societyId String
  name      String
  capacity  Int
  active    Boolean @default(true)

  society Society  @relation(fields: [societyId], references: [id])
  parcels Parcel[]

  @@unique([societyId, name])
}

model Parcel {
  id                 String       @id @default(uuid())
  societyId          String
  parcelCode         String
  qrToken            String       @unique @default(uuid())
  courier            String
  trackingNumber     String
  unitId             String
  recipientName      String?
  receivedById       String
  receivedAt         DateTime     @default(now())
  storageLocationId  String?
  photoRef           String?
  status             ParcelStatus @default(RECEIVED)
  statusUpdatedAt    DateTime     @default(now())
  failedAttemptCount Int          @default(0)
  notes              String?
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  society         Society          @relation(fields: [societyId], references: [id])
  unit            Unit             @relation(fields: [unitId], references: [id])
  receivedBy      User             @relation("ReceivedBy", fields: [receivedById], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  schedules       DeliverySchedule[]
  tasks           DeliveryTask[]
  otpChallenges   HandoverChallenge[]
  pickupRequests  PickupRequest[]
  auditLogs       AuditLog[]

  @@unique([societyId, courier, trackingNumber])
  @@unique([societyId, parcelCode])
  @@index([societyId, status])
  @@index([societyId, unitId])
}

model SlotTemplate {
  id             String   @id @default(uuid())
  societyId      String
  label          String
  startTime      String // HH:MM
  endTime        String // HH:MM
  capacity       Int
  activeWeekdays Int[] // 0=Sun, 6=Sat
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  society   Society       @relation(fields: [societyId], references: [id])
  instances SlotInstance[]
}

model SlotInstance {
  id          String             @id @default(uuid())
  societyId   String
  templateId  String
  date        String // YYYY-MM-DD
  startTime   String
  endTime     String
  capacity    Int
  bookedCount Int                @default(0)
  status      SlotInstanceStatus @default(OPEN)

  society   Society          @relation(fields: [societyId], references: [id])
  template  SlotTemplate     @relation(fields: [templateId], references: [id])
  schedules DeliverySchedule[]

  @@unique([templateId, date])
  @@index([societyId, date, status])
}

model DeliverySchedule {
  id             String                 @id @default(uuid())
  parcelId       String
  requestedById  String
  slotInstanceId String
  status         DeliveryScheduleStatus @default(ACTIVE)
  deliveryNote   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  parcel       Parcel       @relation(fields: [parcelId], references: [id])
  slotInstance SlotInstance @relation(fields: [slotInstanceId], references: [id])
  tasks        DeliveryTask[]
}

model DeliveryTask {
  id           String     @id @default(uuid())
  scheduleId   String
  parcelId     String
  executiveId  String?
  status       TaskStatus @default(OPEN)
  assignedById String?
  assignedAt   DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime   @default(now())

  schedule   DeliverySchedule  @relation(fields: [scheduleId], references: [id])
  parcel     Parcel            @relation(fields: [parcelId], references: [id])
  executive  User?             @relation("AssignedExecutive", fields: [executiveId], references: [id])
  attempts   DeliveryAttempt[]
  challenges HandoverChallenge[]
}

model HandoverChallenge {
  id           String             @id @default(uuid())
  parcelId     String
  taskId       String?
  hashedOtp    String
  expiresAt    DateTime
  attemptsUsed Int                @default(0)
  maxAttempts  Int                @default(5)
  status       OtpChallengeStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())

  parcel Parcel        @relation(fields: [parcelId], references: [id])
  task   DeliveryTask? @relation(fields: [taskId], references: [id])

  @@index([parcelId, status])
}

model DeliveryAttempt {
  id                 String                 @id @default(uuid())
  taskId             String
  executiveId        String
  outcome            DeliveryAttemptOutcome
  verificationMethod VerificationMethod
  failureReason      FailureReason?
  overrideReason     String?
  overrideApproverId String?
  proofPhotoRef      String?
  receiverName       String?
  createdAt          DateTime               @default(now())

  task DeliveryTask @relation(fields: [taskId], references: [id])
}

model PickupRequest {
  id                 String              @id @default(uuid())
  parcelId           String
  requestedById      String
  status             PickupRequestStatus @default(REQUESTED)
  verifiedById       String?
  verificationMethod VerificationMethod?
  completedAt        DateTime?
  note               String?
  createdAt          DateTime            @default(now())

  parcel     Parcel @relation(fields: [parcelId], references: [id])
  verifiedBy User?  @relation("VerifiedBy", fields: [verifiedById], references: [id])
}

model Notification {
  id              String               @id @default(uuid())
  userId          String
  societyId       String
  type            NotificationCategory
  title           String
  message         String
  relatedParcelId String?
  read            Boolean              @default(false)
  createdAt       DateTime             @default(now())

  user    User    @relation(fields: [userId], references: [id])
  society Society @relation(fields: [societyId], references: [id])

  @@index([userId, read])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  societyId     String
  eventType     String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  processedAt   DateTime?
  createdAt     DateTime          @default(now())

  society Society @relation(fields: [societyId], references: [id])

  @@index([status, nextAttemptAt])
}

model DeviceToken {
  id       String   @id @default(uuid())
  userId   String
  platform String
  token    String   @unique
  lastSeen DateTime @default(now())
  active   Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

model NotificationPreference {
  id       String               @id @default(uuid())
  userId   String
  category NotificationCategory
  enabled  Boolean              @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
}

model AuditLog {
  id             String    @id @default(uuid())
  societyId      String
  parcelId       String?
  actorId        String?
  actorRole      UserRole?
  eventType      String
  previousStatus String?
  newStatus      String?
  metadata       Json?
  requestId      String?
  flagged        Boolean   @default(false)
  createdAt      DateTime  @default(now())

  society Society @relation(fields: [societyId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id])
  parcel  Parcel? @relation(fields: [parcelId], references: [id])

  @@index([societyId, createdAt])
  @@index([parcelId])
}
